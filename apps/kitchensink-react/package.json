{
  "name": "@sanity/kitchensink-react",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm tsc && sanity build",
    "clean": "rimraf dist",
    "deploy": "sanity deploy",
    "dev": "sanity dev",
    "dev:e2e": "sanity dev",
    "install": "npm run schema:extract && npm run types:generate",
    "lint": "eslint .",
    "preview": "sanity preview",
    "schema:extract": "sanity schema extract --workspace ppsg7ml5-test --path schema.ppsg7ml5.test.json --force && sanity schema extract --workspace vo1ysemo-production --path schema.vo1ysemo.production.json --force",
    "test:e2e": "playwright test",
    "tsc": "tsc --noEmit",
    "types:generate": "node scripts/typegen.mjs"
  },
  "dependencies": {
    "@portabletext/editor": "8.1.2",
    "@portabletext/keyboard-shortcuts": "^3.0.0",
    "@portabletext/plugin-sdk-value": "8.1.1",
    "@portabletext/toolbar": "^9.0.7",
    "@sanity/icons": "^5.2.1",
    "@sanity/sdk": "workspace:*",
    "@sanity/sdk-react": "workspace:*",
    "@sanity/ui": "^4.0.7",
    "groq": "catalog:",
    "inter-ui": "^4.1.1",
    "json-edit-react": "^1.30.2",
    "react": "catalog:",
    "react-compiler-runtime": "catalog:",
    "react-dom": "catalog:",
    "react-error-boundary": "catalog:",
    "react-refractor": "^4.0.0",
    "react-router": "^7.18.3",
    "refractor": "^5.0.0",
    "styled-components": "^6.5.3",
    "typescript": "catalog:",
    "ui5": "npm:@sanity/ui@5.0.0-alpha.8"
  },
  "devDependencies": {
    "@playwright/test": "catalog:",
    "@repo/config-eslint": "workspace:*",
    "@repo/e2e": "workspace:*",
    "@repo/tsconfig": "workspace:*",
    "@sanity/codegen": "3.88.1-typegen-experimental.0",
    "@testing-library/jest-dom": "catalog:",
    "@testing-library/react": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "eslint": "catalog:",
    "oxfmt": "catalog:",
    "sanity": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
