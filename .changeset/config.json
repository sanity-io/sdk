{
  "$schema": "https://unpkg.com/@changesets/config@4.0.1/schema.json",
  "changelog": ["./changelog.mjs", {"repo": "sanity-io/sdk"}],
  "commit": false,
  "fixed": [["@sanity/sdk", "@sanity/sdk-react"]],
  "access": "public",
  "baseBranch": "main",
  "updateInternalDependencies": "patch",
  "ignore": [],
  "privatePackages": {"version": false, "tag": false},
  "snapshot": {"useCalculatedVersion": true, "prereleaseTemplate": "{tag}.{datetime}"}
}
